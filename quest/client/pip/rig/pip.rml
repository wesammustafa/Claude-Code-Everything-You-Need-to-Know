            </Node>

            <!-- Ground shadow: a circle squashed flat, so its radial gradient becomes an ellipse. -->
            <Node x="400" y="766" scaleY="0.11" name="Shadow" id="0:150">
                <Shape name="Shadow Shape">
                    <Ellipse originX="0.5" originY="0.5" width="460" height="460"/>
                    <Fill>
                        <RadialGradient startX="0" startY="0" endX="230" endY="0">
                            <GradientStop colorValue="47000000" position="0"/>
                            <GradientStop colorValue="2A000000" position="0.55"/>
                            <GradientStop colorValue="00000000" position="1"/>
                        </RadialGradient>
                    </Fill>
                </Shape>
            </Node>
        </Node>

        <!-- The head gaze's driver, outside Pip so its position is plain artboard
             space. Look follows gazeX and gazeY through the eyes' converters (EyesX:
             24 at -1, -24 at 1; EyesY: -14 to 14, both eased 150 ms); Glance, inside
             it, is the Body layer's own small looks around that gaze, so the two add.
             The Look joystick reads Glance across its box and scrubs Turn and Pitch:
             Turn frame 0 left, 44 forward, 88 right; Pitch frame 0 up, 40 level, 80 down.
             Turn Lead, round Look, lets a Reaction turn the head toward its own target
             blended with the gaze: its scaleX keeps that share of the gaze's turn and
             its x adds the rest toward the target. Every Body timeline keys it (x 0 and
             scaleX 1 at rest, the gaze alone); Explaining turns it toward the hint. -->
        <Node name="Turn Lead" id="0:716">
            <Node name="Look" id="0:710">
                <DataBindContext sourcePathIds="0:40-0:41" propertyKey="13" converterId="0:50"/>
                <DataBindContext sourcePathIds="0:40-0:43" propertyKey="14" converterId="0:51"/>
                <Node name="Glance" id="0:711"/>
            </Node>
        </Node>
        <Joystick posX="0" posY="0" width="48" height="28" xId="0:720" yId="0:721" handleSourceId="0:711" invertX="true" name="Look" id="0:712"/>

        <!-- The Cock's driver: Curious cocks Pip's head toward whichever side its
             target is on, so the cock always agrees with the head turn. Curious
             Side follows the side of the head's eased turn through CuriousSide
             (-20 for a target on the left, 20 on the right or straight ahead);
             Curiosity,
             its parent, is how far the cock goes, which the Body layer keys (0 at
             rest, 1 in Curious), so Curious Side sits at their product. The Cock
             joystick reads it and scrubs the Cock timeline. -->
        <Node name="Curiosity" id="0:713" scaleX="0">
            <Node name="Curious Side" id="0:714">
                <DataBindContext sourcePathIds="0:40-0:41" propertyKey="13" converterId="0:58"/>
            </Node>
        </Node>
        <Joystick posX="0" posY="0" width="48" height="28" xId="0:722" handleSourceId="0:714" name="Cock" id="0:715"/>

        <StateMachine name="Pip" id="0:7">
            <!-- Body: the modes Pip holds, and the Reactions Pip plays once from the
                 Any state, each returning to the current mode at its end. The
                 runtime never moves a layer into the state it is already in, so
                 each Reaction has a second, identical state ("again"): the Any
                 state lists the first, then the second, and the same Reaction
                 fired while it plays starts over in whichever is not playing.
                 No Reaction state resets the pose on entry: a Reaction, new or
                 the same again, starts its timeline from the beginning and
                 blends in over 160 ms from wherever Pip is, never from rest.
                 Every mix here allows an early exit, so a Reaction fired while
                 another blends in, or while Pip blends back to a mode, still
                 replaces it. Under reduced motion each Reaction plays its Still
                 version, expression only, fading in and out over 120 ms. -->
            <StateMachineLayer name="Body" id="0:8">
                <AnyState x="560" y="-200">
                    <StateTransition stateToId="0:17" duration="160" interpolationType="cubic" enableEarlyExit="true" interpolatorId="0:780">
                        <TransitionViewModelCondition> <!-- success fired -->
