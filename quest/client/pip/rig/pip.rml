                    <KeyFrameDouble value="1" frame="66"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- The Blink layer's timelines. They alone key the eyes' height, so no Body timeline may. -->
        <!-- Blinking: at uneven gaps over 863 frames, once twice. 863 is prime, so the
             loop never lines up with Idle's 720 and the blinks fall at new points
             against the glances each time round: the pattern repeats only after
             hours. -->
        <LinearAnimation loopValue="loop" duration="863" name="Blink" id="0:22">
            <KeyedObject objectId="0:121"> <!-- Blink: the eyes' height -->
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="180" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="184" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="190" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="360" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="364" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="370" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="504" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="508" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="514" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="672" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="676" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="682" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="688" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="692" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="698" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="840" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="844" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="850" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="863"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Eyes Open: held open, for Rest and reduced motion. -->
        <LinearAnimation loopValue="loop" duration="60" name="Eyes Open" id="0:29">
            <KeyedObject objectId="0:121"> <!-- Blink: the eyes' height -->
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" frame="0"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Turn: written by quest/client/pip/turn.ts (npm run pip:turn); never edit it by hand. -->
        <!-- Turn: the head turn the joystick scrubs, from gazeX -1 (frame 0) through
             the front view (frame 4) to 1 (frame 8), drawn from a box model of the
             board's turnaround views. The head is a box 580 wide, 392 deep, with
             40-unit chamfers on its vertical edges; gazeX turns it 55 degrees
             at most, and a point u across and z out of the face lands at
             u cos(a) + z sin(a). So the face slides across the front plane and
             narrows, the side planes trade width with it, the near ear shows its
             outer face and the far one slips behind the head, and the antennas,
             set back on the top face, close in. Each face's colour follows a soft
             key light from the viewer. The torso turns a fifth as far. A face
             turned away has no width. Keys are linear: the samples are close
             enough that the curve between them is the turn itself. -->
        <LinearAnimation duration="8" name="Turn" id="0:720">
            <KeyedObject objectId="0:620"> <!-- Face Front -->
                <KeyedProperty property="x">
                    <KeyFrameDouble value="560.554" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="529.232" frame="1" interpolationType="linear"/>
                    <KeyFrameDouble value="490.503" frame="2" interpolationType="linear"/>
                    <KeyFrameDouble value="446.586" frame="3" interpolationType="linear"/>
                    <KeyFrameDouble value="400" frame="4" interpolationType="linear"/>
                    <KeyFrameDouble value="353.414" frame="5" interpolationType="linear"/>
                    <KeyFrameDouble value="309.497" frame="6" interpolationType="linear"/>
                    <KeyFrameDouble value="270.768" frame="7" interpolationType="linear"/>
                    <KeyFrameDouble value="239.446" frame="8"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:630"> <!-- Face Front: its width -->
                <KeyedProperty property="width">
                    <KeyFrameDouble value="286.788" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="375.92" frame="1" interpolationType="linear"/>
                    <KeyFrameDouble value="443.505" frame="2" interpolationType="linear"/>
                    <KeyFrameDouble value="485.671" frame="3" interpolationType="linear"/>
                    <KeyFrameDouble value="500" frame="4" interpolationType="linear"/>
                    <KeyFrameDouble value="485.671" frame="5" interpolationType="linear"/>
                    <KeyFrameDouble value="443.505" frame="6" interpolationType="linear"/>
                    <KeyFrameDouble value="375.92" frame="7" interpolationType="linear"/>
                    <KeyFrameDouble value="286.788" frame="8"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:640"> <!-- Face Front: its top colour -->
                <KeyedProperty property="colorValue">
