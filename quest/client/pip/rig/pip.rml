            <Node scaleX="-1" opacity="0" name="Strokes" id="0:840">
                <Node x="-708.2" y="108.2" name="Strokes Left" id="0:841"><Shape name="Stroke Shape"><Rectangle x="-29.5" y="-34.1" rotation="0.85" originX="0.5" originY="0.5" width="50" height="18.2" cornerRadiusTL="9.1"/><Rectangle x="-38.6" y="13.6" rotation="0.12" originX="0.5" originY="0.5" width="38.6" height="17" cornerRadiusTL="8.5"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape></Node>
