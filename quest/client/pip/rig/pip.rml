        <!-- The head turn's driver, outside Pip so its position is plain artboard
             space. Look follows gazeX through the eyes' own converter (EyesX: 24 at
             -1, -24 at 1, eased 220 ms on the motion curve); Glance, inside it, is
             the Body layer's own small looks around that gaze, so the two add. The
             Turn joystick reads Glance's x across its box (-24 to 24, inverted) and
             scrubs the Turn timeline: frame 0 turned left, 4 forward, 8 right. -->
        <Node name="Look" id="0:710">
            <DataBindContext sourcePathIds="0:40-0:41" propertyKey="13" converterId="0:50"/>
            <Node name="Glance" id="0:711"/>
        </Node>
        <Joystick posX="0" posY="0" width="48" height="48" xId="0:720" handleSourceId="0:711" invertX="true" name="Turn" id="0:712"/>

        <StateMachine name="Pip" id="0:7">
            <!-- Body: the modes Pip holds, and the Reactions Pip plays once from the
                 Any state, each returning to the current mode at its end. The
                 runtime never moves a layer into the state it is already in, so
                 each Reaction has a second, identical state ("again"): the Any
                 state lists the first, then the second, and the same Reaction
                 fired while it plays starts over in whichever is not playing.
                 No Reaction state resets the pose on entry: a Reaction, new or
                 the same again, starts its timeline from the beginning and
                 blends in over 160 ms from wherever Pip is, never from rest.
                 Every mix here allows an early exit, so a Reaction fired while
                 another blends in, or while Pip blends back to a mode, still
                 replaces it. Under reduced motion each Reaction plays its Still
                 version, expression only, fading in and out over 120 ms. -->
            <StateMachineLayer name="Body" id="0:8">
                <AnyState x="560" y="-200">
                    <StateTransition stateToId="0:17" duration="160" interpolationType="cubic" enableEarlyExit="true">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionViewModelCondition> <!-- success fired -->
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger><DataBindContext sourcePathIds="0:40-0:44" propertyKey="686"/></BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                        <TransitionViewModelCondition> <!-- reducedMotion is false -->
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:40-0:47" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:417" duration="160" interpolationType="cubic" enableEarlyExit="true">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                        <TransitionViewModelCondition> <!-- success fired -->
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger><DataBindContext sourcePathIds="0:40-0:44" propertyKey="686"/></BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
