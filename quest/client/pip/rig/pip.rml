            <KeyedObject objectId="0:605"> <!-- Lid Right -->
                <KeyedProperty property="y"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:606"> <!-- Arch Left: up carves a smiling eye -->
                <KeyedProperty property="y">
                    <KeyFrameDouble value="190" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="190" frame="8" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0.8" x2="0.2" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="46" frame="15" interpolationType="hold"/>
                    <KeyFrameDouble value="46" frame="47" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="190" frame="54"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:607"> <!-- Arch Right -->
                <KeyedProperty property="y">
                    <KeyFrameDouble value="190" frame="0" interpolationType="hold"/>
