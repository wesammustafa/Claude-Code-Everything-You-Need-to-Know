        <!-- Greeting: a friendly open smile, a happy squint and a raised, two-beat wave that
             lowers on an even ease-in-out, as gently as it rose. -->
        <LinearAnimation duration="90" name="Greeting" id="0:320">
            <KeyedObject objectId="0:101"> <!-- Hop: the whole body's lift and squash -->
                <KeyedProperty property="y">
