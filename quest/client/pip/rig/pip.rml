            <!-- The board's elements round Pip, outside Hop so they stay where they
                 appear, and behind him, inside the canvas. Each group is hidden at rest
                 and every Body timeline keys its opacity; only its Reaction shows it,
                 and that Reaction's Still shows it in place, without travel. The groups
                 un-mirror the root (scaleX -1), so their art reads the right way round.
                 At rest each element sits in the band above the head, beside the
                 antennas and inside Pip's own outline, where the Stills show it; the full
                 Reactions pop it and float it up from there. -->
            <!-- Curious's "?", above the head on the content's side. -->
            <Node x="111" y="100" scaleX="-1" opacity="0" name="Question" id="0:810">
                <Node name="Question Pop" id="0:811">
                    <Shape name="Question Mark"><Rectangle x="0" y="-42" originX="0.5" originY="0.5" width="42" height="14" cornerRadiusTL="3"/><Rectangle x="-28" y="-28" originX="0.5" originY="0.5" width="14" height="14" cornerRadiusTL="3"/><Rectangle x="28" y="-21" originX="0.5" originY="0.5" width="14" height="28" cornerRadiusTL="3"/><Rectangle x="7" y="0" originX="0.5" originY="0.5" width="28" height="14" cornerRadiusTL="3"/><Rectangle x="0" y="14" originX="0.5" originY="0.5" width="14" height="14" cornerRadiusTL="3"/><Rectangle x="0" y="42" originX="0.5" originY="0.5" width="14" height="14" cornerRadiusTL="3"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape>
                </Node>
            </Node>
            <!-- Greeting's floating pixel crosses, the board's hero. -->
            <Node scaleX="-1" opacity="0" name="Crosses" id="0:820">
                <Node x="-717" y="94" name="Cross" id="0:821">
                    <Shape name="Cross Shape"><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="36" height="12" cornerRadiusTL="2"/><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="12" height="36" cornerRadiusTL="2"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape>
                </Node>
