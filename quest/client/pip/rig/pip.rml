            <Node scaleX="-1" opacity="0" name="Zs" id="0:860">
                <Node x="-212.7" y="215" name="Z Small" id="0:861"><Shape name="Z Shape"><Rectangle x="0" y="-16.0" originX="0.5" originY="0.5" width="43.2" height="11.2" cornerRadiusTL="2.8"/><Rectangle x="0" y="16.0" originX="0.5" originY="0.5" width="43.2" height="11.2" cornerRadiusTL="2.8"/><Rectangle x="0" y="0" rotation="-0.575" originX="0.5" originY="0.5" width="43.7" height="11.2" cornerRadiusTL="2.8"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape></Node>
