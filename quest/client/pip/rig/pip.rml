                    <KeyFrameDouble value="0.08" frame="844" interpolationType="cubic" interpolatorId="0:785"/>
                    <KeyFrameDouble value="1" frame="850" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <!-- Eyes Open: held open, for Rest and reduced motion. -->
        <LinearAnimation loopValue="loop" duration="60" name="Eyes Open" id="0:29">
            <KeyedObject objectId="0:121"> <!-- Blink: the eyes' height -->
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" frame="0"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Cock: the head's cock the Cock joystick scrubs, from a target on the
             left (frame 0) through level (frame 1) to one on the right (frame 2).
             The root is mirrored, so a cock toward the right is a negative turn.
             Curious Side reaches 20 of the joystick's 24 at Curiosity 1 (0.14 rad),
             so Curiosity's overshoot to 1.12 still turns further (0.157 rad). -->
        <LinearAnimation duration="2" name="Cock" id="0:722">
            <KeyedObject objectId="0:113"> <!-- Head Cock -->
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.168" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-0.168" frame="2"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Turn: written by quest/client/pip/turn.ts (npm run pip:turn); never edit it by hand. -->
        <!-- Turn: the head turn the joystick scrubs across, from gazeX -1 (frame 0)
             through the front view (frame 44) to 1 (frame 88), up to 55 degrees each way.
             It keys the projection's turn terms (the head's faces follow them), each
             wall's colour under a soft key light from the viewer and whether it
             faces the viewer, the face sliding across the front and narrowing, the
             near ear's outer face, the far ear slipping behind the head, the
             antennas closing in, and the torso turning a fifth as far. Keys are
             linear and only where a straight line between them would stray. -->
        <LinearAnimation duration="88" name="Turn" id="0:720">
            <KeyedObject objectId="0:1001"> <!-- Head Across: the turn's cosine -->
