                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="160" y="140" animationId="0:29" id="0:13"> <!-- Eyes Open -->
                    <StateTransition stateToId="0:14">
                        <TransitionViewModelCondition opValue="notEqual"> <!-- mode is not rest -->
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:45" propertyKey="637"/></BindablePropertyEnum>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueEnumComparator value="0:63"/>
                        </TransitionViewModelCondition>
                        <TransitionViewModelCondition> <!-- reducedMotion is false -->
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:40-0:47" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Body timelines. The rest pose: Hop at y 765, unrotated and unscaled;
             Head at y 578; every rotation 0; the smile shown and the open mouth
             hidden; the shadow at full width and opacity. -->
        <!-- Modes. A slow breath. -->
        <LinearAnimation loopValue="loop" duration="180" name="Idle" id="0:20">
            <KeyedObject objectId="0:101"> <!-- Hop: the whole body's lift and squash -->
                <KeyedProperty property="y"><KeyFrameDouble value="765" frame="0"/></KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" frame="0"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" frame="0"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:103"> <!-- Lean Left: the lean onto Foot Left -->
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:104"> <!-- Lean Right: the lean onto Foot Right -->
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:110"> <!-- Head: the neck's rise -->
                <KeyedProperty property="y">
                    <KeyFrameDouble value="578" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="583" frame="90" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="578" frame="180"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:112"> <!-- Head Pose: the head's tilt -->
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:130"> <!-- Arm Left (on screen, the arm toward the content) -->
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:132"> <!-- Arm Right -->
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
            </KeyedObject>
