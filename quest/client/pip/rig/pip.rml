                <Node x="-85.5" y="115" name="Cheer" id="0:853"><Shape name="Cheer Shape"><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="44.4" height="14.8" cornerRadiusTL="2.5"/><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="14.8" height="44.4" cornerRadiusTL="2.5"/><Rectangle x="34.0" y="-23.7" originX="0.5" originY="0.5" width="13.3" height="13.3" cornerRadiusTL="2.5"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape></Node>
