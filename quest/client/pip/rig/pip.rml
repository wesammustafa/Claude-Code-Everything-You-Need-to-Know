        <!-- Pitch: written by quest/client/pip/turn.ts (npm run pip:turn); never edit it by hand. -->
        <!-- Pitch: the head's nod the joystick scrubs down, from gazeY -1, looking up
             (frame 0), through level (frame 40) to 1, looking down (frame 80), up to
             14 degrees each way. It keys the projection's nod terms, the top
             showing looking down and the underside looking up, the face riding
             the front down or up, each ear's top or bottom face, the antennas'
             bases and stalks, and the torso nodding a fifth as far. -->
        <LinearAnimation duration="80" name="Pitch" id="0:721">
            <KeyedObject objectId="0:1003"> <!-- Head Depth: the turn's and the nod's sines -->
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="-0.242" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.242" frame="80"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:1002"> <!-- Head Height: the nod's cosine -->
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.97" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.999" frame="32" interpolationType="linear"/>
                    <KeyFrameDouble value="0.989" frame="64" interpolationType="linear"/>
                    <KeyFrameDouble value="0.97" frame="80"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:1020"> <!-- Top: whether it shows -->
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="40" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:1021"> <!-- Underside: whether it shows -->
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:600"> <!-- Face: the eyes and mouth -->
                <KeyedProperty property="y">
                    <KeyFrameDouble value="314.369" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="421.453" frame="80"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.97" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.999" frame="32" interpolationType="linear"/>
                    <KeyFrameDouble value="0.989" frame="64" interpolationType="linear"/>
                    <KeyFrameDouble value="0.97" frame="80"/>
