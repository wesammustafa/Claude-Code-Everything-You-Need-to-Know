        <!-- Explaining: a small pointing gesture toward the hint, on Pip's right, while
             Pip talks. The head turns toward the hint on its own (Turn Lead), the
             eyes lead it, and the arm lifts out to the side under the head's corner,
             points with two small beats, and lowers back. -->
        <LinearAnimation duration="96" name="Explaining" id="0:322">
            <KeyedObject objectId="0:101"> <!-- Hop: the whole body's lift and squash -->
                <KeyedProperty property="y">
                    <KeyFrameDouble value="765" frame="0"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:103"> <!-- Lean Left: the lean onto Foot Left -->
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic" interpolatorId="0:780"/>
