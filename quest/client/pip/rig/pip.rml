<!--
  Pip, Claude Code Quest's mascot: one artboard holding the art, the state
  machine and its timelines (RML keeps an artboard's timelines and state
  machine inside its own element, so they share this file). The view model,
  its enum and the converters are in view-model.rml.

  Built only by `npm run pip:build` with the pinned Rive CLI. Script-free: no
  Luau, ever.

  The art is the approved board's front view, traced in an 800-unit reference
  space inside the root node, which scales it onto the 400 by 400 artboard.
  gazeX turns and gazeY nods the head from the front view toward the board's
  turnaround views: the Turn and Pitch timelines, scrubbed by a joystick that
  follows the gaze plus the Body layer's own glances. Both timelines and the
  resting values of every part they key are derived from a box model, and only
  quest/client/pip/turn.ts (`npm run pip:turn`) writes them. Each moving part
  pivots at its own node: the neck (Head, Head Pose), the shoulders (Arm Left,
  Arm Right), the stalk bases (Antenna Left, Antenna Right), the soles (Foot
  Left, Foot Right), Hop for the whole body's lift and squash, and the outer
  edge of each sole for its lean (Lean Left, Lean Right), so a lean keeps a foot
  on the floor. Soft shading is feathered fills clipped to the part they shade.

  Three rules bind every timeline:
  - each Body timeline keys the whole rest pose, so any state blends back to it
    without a jump;
  - a blend state's exit names the timeline that times it (exitBlendAnimationId);
  - the Body layer never keys what the Turn and Pitch timelines key (the head's
    projection, face, ears, antennas and torso), so the gaze and poses add up.
  The Blink layer alone keys the Blink node's height (a later layer wins). The
  eyes' expression goes on Glance Eyes, Blink's parent, which every Body
  timeline keys (its scaleY, the eye bars' height, and its x and y), so a blink
  still plays on top of any expression.
-->
<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" styleId="0:5" viewModelId="0:40" viewModelInstanceId="0:42" width="400" height="400" name="Pip" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Curves: every eased keyframe and transition names one of these by
             interpolatorId, so each curve is stored once. -->
        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:780"/> <!-- ease-in-out -->
        <CubicEaseInterpolator x1="0.65" y1="0" x2="0.35" y2="1" id="0:781"/> <!-- strong ease-in-out -->
        <CubicEaseInterpolator x1="0.2" y1="0.8" x2="0.2" y2="1" id="0:782"/> <!-- glance out -->
        <CubicEaseInterpolator x1="0.15" y1="0.6" x2="0.4" y2="1" id="0:783"/> <!-- spring off -->
        <CubicEaseInterpolator x1="0.55" y1="0" x2="0.85" y2="0.6" id="0:784"/> <!-- fall -->
        <CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1" id="0:785"/> <!-- ease-out -->
        <CubicEaseInterpolator x1="0.3" y1="0" x2="0.7" y2="1" id="0:786"/> <!-- gentle ease-in-out -->
        <CubicEaseInterpolator x1="0.25" y1="0.1" x2="0.25" y2="1" id="0:787"/> <!-- ease -->
        <CubicEaseInterpolator x1="0.3" y1="0" x2="0.2" y2="1" id="0:788"/> <!-- quick settle -->
        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.3" y2="1" id="0:789"/> <!-- settle -->
        <CubicEaseInterpolator x1="0.5" y1="0" x2="0.75" y2="0.8" id="0:790"/> <!-- fall into the landing -->
        <CubicEaseInterpolator x1="0.55" y1="0" x2="0.6" y2="1" id="0:791"/> <!-- late ease-in-out -->
        <CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1" id="0:792"/> <!-- ease-in -->

