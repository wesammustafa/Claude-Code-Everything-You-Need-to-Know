            <Node scaleX="-1" opacity="0" name="Thinking Dots" id="0:830">
                <Node x="-178.2" y="69.5" name="Dot" id="0:831"><Shape name="Dot Shape"><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="29.5" height="29.5" cornerRadiusTL="6.8"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape></Node>
                <Node x="-119.1" y="69.5" name="Dot" id="0:832"><Shape name="Dot Shape"><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="29.5" height="29.5" cornerRadiusTL="6.8"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape></Node>
                <Node x="-60" y="69.5" name="Dot" id="0:833"><Shape name="Dot Shape"><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="29.5" height="29.5" cornerRadiusTL="6.8"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape></Node>
            </Node>
            <!-- Success's spark strokes beside the head, the board's Happy: they burst out
