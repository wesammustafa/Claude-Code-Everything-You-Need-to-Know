            <Node scaleX="-1" opacity="0" name="Cheers" id="0:850">
                <Node x="-712.7" y="119.5" name="Cheer" id="0:851"><Shape name="Cheer Shape"><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="44.4" height="14.8" cornerRadiusTL="2.5"/><Rectangle x="0" y="0" originX="0.5" originY="0.5" width="14.8" height="44.4" cornerRadiusTL="2.5"/><Rectangle x="34.0" y="-23.7" originX="0.5" originY="0.5" width="13.3" height="13.3" cornerRadiusTL="2.5"/><Fill><SolidColor colorValue="FFFF8A4C"/></Fill></Shape></Node>
