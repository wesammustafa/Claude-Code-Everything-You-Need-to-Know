{
  "name": "claude-code-everything-you-need-to-know",
  "private": true,
  "workspaces": [
    "quest/*"
  ],
  "scripts": {
    "guide": "node .github/scripts/check.mjs",
    "guide:selftest": "node --test '.github/scripts/test/**/*.test.mjs'",
    "typecheck": "tsc -b",
    "lint": "eslint quest --max-warnings 0 && prettier --check quest",
    "test:quest": "vitest run",
    "test:checks": "node --test 'practice-template/checks/test/*.test.mjs'",
    "test:starter": "node --test 'practice-template/project/test/**/*.test.js'",
    "build": "npm run build --workspaces --if-present",
    "e2e": "playwright test -c quest/client/playwright.config.ts",
    "pip:build": "node quest/client/pip/build.ts",
    "pip:turn": "node quest/client/pip/turn.ts",
    "dev": "node quest/client/dev.ts",
    "verify": "npm run guide:selftest && npm run guide && npm run typecheck && npm run lint && npm run test:quest && npm run test:checks && npm run test:starter"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
